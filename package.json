{
  "name": "string-art-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "playwright test",
    "compare": "node tools/compare-schemes.mjs",
    "mobile:build": "vite build --config mobile-app/vite.config.mjs",
    "mobile:sync": "pnpm mobile:build && cap sync",
    "mobile:doctor": "cap doctor",
    "mobile:ios": "cap open ios",
    "mobile:android": "cap open android",
    "mobile:run:ios": "pnpm mobile:sync && cap run ios",
    "mobile:run:android": "pnpm mobile:sync && cap run android",
    "mobile:dev:ios": "node tools/mobile-preflight.mjs ios && CAPACITOR_SERVER_URL=http://localhost:3000 cap run ios",
    "mobile:dev:android": "CAPACITOR_SERVER_URL=http://10.0.2.2:3000 cap run android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "lucide-react": "1.25.0",
    "next": "16.2.11",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
